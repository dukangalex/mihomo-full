# Mihomo-Full Telegram 管理机器人示例
# 复制为 telegram-bot.env，仅保存在 VPS，禁止提交真实 token。

# 从 @BotFather 创建机器人后填写
TG_BOT_TOKEN=REPLACE_WITH_BOT_TOKEN

# 只允许这些 Telegram 用户 ID 操作，逗号分隔。
# 强烈建议填写，空值将被机器人拒绝启动。
TG_ADMIN_IDS=123456789

# Mihomo-Full 安装目录
MIHOMO_FULL_DIR=/opt/mihomo-full

# VPS 套餐参数（购买 VPS 时确定）
# 月总流量，单位 GiB；0 表示不设置额度，仅统计实际使用量。
VPS_MONTHLY_GB=0

# VPS 到期时间，ISO 8601；例如 2026-12-31T23:59:59Z。
# 留空表示不设置到期日。
VPS_EXPIRES_AT=

# 流量告警阈值，百分比；例如 80 表示达到月额度的 80% 时提示。
VPS_TRAFFIC_ALERT_PERCENT=80

# 可选：指定统计网卡，例如 eth0、ens3；留空则自动检测默认 IPv4 出口网卡。
VPS_TRAFFIC_INTERFACE=
